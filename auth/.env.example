APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Toronto
# Public URL of the auth service (no trailing slash)
APP_URL=https://auth.sailConnect.org
# Parent domain shared by all applications; the session cookie is scoped to it.
# Leave empty for local development (host-only cookie).
COOKIE_DOMAIN=.sailConnect.org
COOKIE_NAME=sc_session
# Hosts that sign-in may redirect back to (comma-separated suffixes)
ALLOWED_RETURN_HOSTS=sailConnect.org

# Path to the auth SQLite database
DB_PATH=./database/auth.db

# --- Platform settings ---
CLUB_ADMIN_EMAIL=
# Minutes of inactivity before a session expires
INACTIVITY_EXPIRY_MINUTES=30
# Hard cap on session age regardless of activity (hours)
SESSION_MAX_HOURS=168
TERMS_OF_USE_URL=

# --- Cloudflare Turnstile (these are Cloudflare's always-pass test keys) ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@sailConnect.org
EMAIL_FROM_NAME="Sail Connect"

# --- First platform admin (used by the seeder) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PASSWORD=
