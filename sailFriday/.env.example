# Sail Friday - Environment Configuration Example
# Copy this file to .env and update with your values

# Database
DB_PATH=/var/www/html/sailConnect/sailFriday/database/sailFriday.db

# sailConnect single sign-on: directory of the auth service (holds its .env and database).
# Defaults to ../auth next to this application.
#AUTH_DIR=/var/www/html/sailConnect/auth

# Email - Local Development (APP_ENV=development or local)
# Emails are captured by MailHog (https://github.com/mailhog/MailHog) instead of being delivered.
# Start MailHog, then view captured emails at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=

# Email - Production (APP_ENV=production)
# Mailjet API keys (https://app.mailjet.com → Account Settings → API Key Management)
MJ_APIKEY_PUBLIC=your_mailjet_public_api_key
MJ_APIKEY_PRIVATE=your_mailjet_private_api_key

# Email Configuration
EMAIL_FROM=nsc-sdc@nsc.ca
EMAIL_FROM_NAME="Sail Friday"
ADMIN_NOTIFICATION_EMAIL=nsc-sdc@nsc.ca
REGISTRATION_NOTIFICATION_EMAIL_SECONDARY=admin@nsc.ca

# Application Settings
APP_DEBUG=false
APP_ENV=production
APP_TIMEZONE=America/Toronto
APP_URL=https://sailfriday.sailconnect.org

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://sailfriday.sailconnect.org
