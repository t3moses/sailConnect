{
    "name": "sailfriday/sailing-club",
    "description": "Sail Friday Program Management System",
    "license": "proprietary",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../auth"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "eluceo/ical": "^2.13",
        "mailjet/mailjet-apiv3-php": "^1.6",
        "monolog/monolog": "^3.0",
        "phpmailer/phpmailer": "^7.0",
        "robmorgan/phinx": "^0.16",
        "sailconnect/auth": "*@dev",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.23"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}