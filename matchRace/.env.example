# Match Race - Environment Configuration Example
# Copy this file to .env and update with your values

# Database
DB_PATH=./database/matchRace.db

# sailConnect single sign-on: directory of the auth service (holds its .env and database).
# Defaults to ../auth next to this application.
#AUTH_DIR=/var/www/html/sailConnect/auth
# Overrides the database path found in the auth service's .env (useful for local development).
#AUTH_DB_PATH=
